<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>beforeRunningCommand</key>
	<string>saveModifiedFiles</string>
	<key>command</key>
	<string>#!/bin/bash
. "$TM_BUNDLE_SUPPORT/lib/rails_commands.sh"
rails_require_root

test=$(rails_test_file) || rails_exit_tool_tip "There is no test for this file."
[[ -n "$test" ]] || rails_exit_tool_tip "There is no test for this file."
rails_html_task "Test ${test##*/}" test "$test"
</string>
	<key>input</key>
	<string>none</string>
	<key>inputFormat</key>
	<string>text</string>
	<key>keyEquivalent</key>
	<string>^\</string>
	<key>name</key>
	<string>Test Current File</string>
	<key>outputCaret</key>
	<string>afterOutput</string>
	<key>outputFormat</key>
	<string>html</string>
	<key>outputLocation</key>
	<string>newWindow</string>
	<key>scope</key>
	<string>source.ruby.rails, source.yaml</string>
	<key>uuid</key>
	<string>35233B9D-E361-4647-9014-94A72C63ACBD</string>
	<key>version</key>
	<integer>2</integer>
</dict>
</plist>
