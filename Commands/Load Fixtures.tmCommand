<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>beforeRunningCommand</key>
	<string>saveModifiedFiles</string>
	<key>command</key>
	<string>#!/bin/bash
. "$TM_BUNDLE_SUPPORT/lib/rails_commands.sh"
rails_require_root

rails_confirm "Load fixtures into the development database?" "This replaces the data in every table that has fixtures." "Load Fixtures" || rails_exit_discard
rails_html_task "Load Fixtures (Development DB)" db:fixtures:load
</string>
	<key>input</key>
	<string>none</string>
	<key>inputFormat</key>
	<string>text</string>
	<key>keyEquivalent</key>
	<string>^|</string>
	<key>name</key>
	<string>Load Fixtures (Development DB)</string>
	<key>outputCaret</key>
	<string>afterOutput</string>
	<key>outputFormat</key>
	<string>html</string>
	<key>outputLocation</key>
	<string>newWindow</string>
	<key>scope</key>
	<string>source.ruby.rails, source.yaml</string>
	<key>uuid</key>
	<string>5EEA0C71-B34B-4408-953B-F47AAD343CCC</string>
	<key>version</key>
	<integer>2</integer>
</dict>
</plist>
