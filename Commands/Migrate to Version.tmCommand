<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>beforeRunningCommand</key>
	<string>saveModifiedFiles</string>
	<key>command</key>
	<string>#!/bin/bash
. "$TM_BUNDLE_SUPPORT/lib/rails_commands.sh"
rails_require_root

# The 50 most recent migrations, newest first.
items=()
for file in "$RAILS_ROOT"/db/migrate/*.rb; do
	[[ -e "$file" ]] || continue
	name=$(basename "$file" .rb)
	version=${name%%_*}
	title="${name#*_}  —  ${version:0:4}-${version:4:2}-${version:6:2} ${version:8:2}:${version:10:2}"
	items=("$title" "$version" "${items[@]:0:98}")
done
[[ ${#items[@]} -gt 0 ]] || rails_exit_tool_tip "There are no migrations in db/migrate."

version=$(rails_menu "${items[@]}") || rails_exit_discard
rails_html_task "Migrate to Version $version" db:migrate "VERSION=$version"
</string>
	<key>input</key>
	<string>none</string>
	<key>inputFormat</key>
	<string>text</string>
	<key>keyEquivalent</key>
	<string>^|</string>
	<key>name</key>
	<string>Migrate to Version…</string>
	<key>outputCaret</key>
	<string>afterOutput</string>
	<key>outputFormat</key>
	<string>html</string>
	<key>outputLocation</key>
	<string>newWindow</string>
	<key>scope</key>
	<string>source.ruby.rails, source.yaml</string>
	<key>uuid</key>
	<string>07C696F8-79F5-4E0B-9EE9-03B693A54ABB</string>
	<key>version</key>
	<integer>2</integer>
</dict>
</plist>
