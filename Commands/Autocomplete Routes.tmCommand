<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>beforeRunningCommand</key>
	<string>nop</string>
	<key>command</key>
	<string>#!/bin/bash
. "$TM_BUNDLE_SUPPORT/lib/rails_commands.sh"
rails_require_root
export RAILS_ROOT

# The completions of the document’s language server, from the Language Server
# bundle (which this command requires, for TM_LANGUAGE_SERVER_BUNDLE_SUPPORT):
# the items of a property list, or nothing.
completions=""
if [[ -x "${TM_LANGUAGE_SERVER_BUNDLE_SUPPORT:-}/bin/completions" ]]; then
	completions=$("$TM_LANGUAGE_SERVER_BUNDLE_SUPPORT/bin/completions" 2&gt;/dev/null | sed -n '/^&lt;array&gt;$/,/^&lt;\/array&gt;$/{/^&lt;\/*array&gt;$/d;p;}')
fi

# Listing the routes starts the application, so they are cached until a
# routes file changes.
cache="${TMPDIR:-/tmp}/textmate-rails-routes-$(printf '%s' "$RAILS_ROOT" | /sbin/md5 -q).txt"
if [[ ! -s "$cache" || -n "$(find "$RAILS_ROOT/config/routes.rb" "$RAILS_ROOT/config/routes" -newer "$cache" 2&gt;/dev/null | head -n 1)" ]]; then
	if rails_run_with_timeout 60 bin/rails runner 'Rails.application.reload_routes!; puts Rails.application.routes.named_routes.names.sort' &gt; "$cache.new" 2&gt;/dev/null; then
		mv "$cache.new" "$cache"
	else
		rm -f "$cache.new"
		[[ -n "$completions" ]] || rails_exit_tool_tip "Could not list the routes of this application (bin/rails runner failed or took longer than a minute)."
	fi
fi

typed=$(printf '%s' "${TM_CURRENT_LINE:0:${TM_LINE_INDEX:-0}}" | grep -oE '[A-Za-z0-9_]+$')
routes=""
while IFS= read -r name; do
	[[ "$name" =~ ^[a-z_][a-z0-9_]*$ ]] || continue
	# Routes Rails and its frameworks add for themselves.
	[[ "$name" =~ ^(rails_(info|mailers|conductor|blob|direct_uploads|disk_service|service_blob|storage|representation|relay|incoming|inbound|mandrill|mailgun|postmark|sendgrid|mailbox)|update_rails_disk_service|turbo_(recede|refresh|resume)_) ]] &amp;&amp; continue
	routes+="&lt;dict&gt;&lt;key&gt;display&lt;/key&gt;&lt;string&gt;${name}_path&lt;/string&gt;&lt;/dict&gt;&lt;dict&gt;&lt;key&gt;display&lt;/key&gt;&lt;string&gt;${name}_url&lt;/string&gt;&lt;/dict&gt;"
done &lt; &lt;(cat "$cache" 2&gt;/dev/null)
[[ -n "$routes$completions" ]] || rails_exit_tool_tip "This application has no named routes."

# The routes first, then the language server’s completions.
"$DIALOG" popup --suggestions "&lt;?xml version=\"1.0\" encoding=\"UTF-8\"?&gt;&lt;plist version=\"1.0\"&gt;&lt;array&gt;$routes$completions&lt;/array&gt;&lt;/plist&gt;" --alreadyTyped "$typed" --additionalWordCharacters "_?!" &gt;/dev/null
rails_exit_discard
</string>
	<key>input</key>
	<string>none</string>
	<key>inputFormat</key>
	<string>text</string>
	<key>keyEquivalent</key>
	<string>~</string>
	<key>name</key>
	<string>Autocomplete Routes</string>
	<key>outputCaret</key>
	<string>afterOutput</string>
	<key>outputFormat</key>
	<string>text</string>
	<key>outputLocation</key>
	<string>discard</string>
	<key>require</key>
	<array>
		<dict>
			<key>name</key>
			<string>Language Server</string>
			<key>uuid</key>
			<string>2B7B90FA-78B7-4922-98C7-C025E4F932B4</string>
		</dict>
	</array>
	<key>scope</key>
	<string>source.ruby.rails, text.html.erb.rails, source.ruby.rails attr.language-server, text.html.erb.rails attr.language-server</string>
	<key>uuid</key>
	<string>0742F232-38ED-4C52-AD68-1858F0F2C601</string>
	<key>version</key>
	<integer>2</integer>
</dict>
</plist>
