<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>beforeRunningCommand</key>
	<string>saveModifiedFiles</string>
	<key>command</key>
	<string>#!/bin/bash
. "$TM_BUNDLE_SUPPORT/lib/rails_commands.sh"
rails_require_root

file=${TM_FILEPATH#"$RAILS_ROOT"/}
[[ "$file" == test/*_test.rb ]] || rails_exit_tool_tip "Test at Caret runs the test around the caret, so it only works in a test file."
rails_html_task "Test ${file##*/}:$TM_LINE_NUMBER" test "$file:$TM_LINE_NUMBER"
</string>
	<key>input</key>
	<string>none</string>
	<key>inputFormat</key>
	<string>text</string>
	<key>keyEquivalent</key>
	<string>^\</string>
	<key>name</key>
	<string>Test at Caret</string>
	<key>outputCaret</key>
	<string>afterOutput</string>
	<key>outputFormat</key>
	<string>html</string>
	<key>outputLocation</key>
	<string>newWindow</string>
	<key>scope</key>
	<string>source.ruby.rails, source.yaml</string>
	<key>uuid</key>
	<string>037F8499-A70C-4051-851C-D7887934B3D8</string>
	<key>version</key>
	<integer>2</integer>
</dict>
</plist>
